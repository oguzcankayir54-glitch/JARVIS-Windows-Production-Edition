# J.A.R.V.I.S. configuration template.
# Copy to `.env` and fill in. NEVER commit the real `.env` (it is gitignored).

# custom | lite | windows-dev | windows-production
JARVIS_PROFILE=custom

# --- LLM ---
# Provider: "mock" (no model, for testing) or "ollama" (local inference)
JARVIS_LLM_PROVIDER=mock
JARVIS_OLLAMA_HOST=http://localhost:11434
JARVIS_OLLAMA_MODEL=qwen2.5:14b-instruct
# Boş bırakılırsa fallback kapalıdır. Model missing/OOM/persistent timeout
# durumunda kullanılır; Ollama sunucusu kapalıysa aynı sunucuda denenmez.
JARVIS_OLLAMA_FALLBACK_MODEL=
JARVIS_OLLAMA_MAX_RETRIES=1
JARVIS_OLLAMA_CIRCUIT_COOLDOWN=30
JARVIS_OLLAMA_THINK=false
JARVIS_OLLAMA_NUM_PREDICT=512
JARVIS_OLLAMA_KEEP_ALIVE=30m
# Örnekleme. Ollama'nın kendi varsayılanı 0.8 — düzyazı için iyi, teknik
# asistan için gevşek. Yüksek sıcaklık Türkçede bozuk ek/çekim üretir:
# her adımda model daha az olası kelimeye itilir ve yanlış bir ek cümleyi
# renklendirmez, bozar. Daha da tutarlı istiyorsanız 0.2'ye indirin.
JARVIS_TEMPERATURE=0.35
JARVIS_TOP_P=0.9
JARVIS_REPEAT_PENALTY=1.1

# --- Proaktif sistem takibi (Aşama 12) ---
JARVIS_MONITOR_ENABLED=true
JARVIS_MONITOR_INTERVAL=15
JARVIS_MONITOR_HEALTH_INTERVAL=60
JARVIS_MONITOR_COOLDOWN=300
JARVIS_MONITOR_RECOVERY_SAMPLES=2
JARVIS_MONITOR_RAM_WARNING=85
JARVIS_MONITOR_RAM_CRITICAL=95
JARVIS_MONITOR_DISK_WARNING=90
JARVIS_MONITOR_DISK_CRITICAL=97
JARVIS_MONITOR_GPU_TEMP_WARNING=80
JARVIS_MONITOR_GPU_TEMP_CRITICAL=90
JARVIS_MONITOR_VRAM_WARNING=85
JARVIS_MONITOR_VRAM_CRITICAL=95

# --- Ana yerel ses (XTTS-v2 · Craig dengeli) ---
# Kurulum: pip install -e ".[ses-xtts]"
# Coqui Public Model License koşullarını kabul ettiğinizi belirtir.
COQUI_TOS_AGREED=1
JARVIS_XTTS_SPEAKER=Craig Gutsy
JARVIS_XTTS_SPEED=1.04
JARVIS_XTTS_DEVICE=auto
# Model uygulama açılırken arka planda yüklenir; ilk cevap gecikmez.
JARVIS_XTTS_PRELOAD=true
# Panel açılmadan modeli tamamen hazırlar; konuşma sırasında soğuk yük beklenmez.
JARVIS_XTTS_READY_BEFORE_LISTEN=true
# Yalnızca RAM'de tutulur; konuşma metni veya ses diske yazılmaz.
JARVIS_XTTS_CACHE_SIZE=32
JARVIS_XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# --- İsteğe bağlı yedek (ElevenLabs TTS) ---
# Anahtarı: elevenlabs.io → Profile → API Keys
# Voice ID'yi bulmak için: jarvis-ses --sesler
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# J.A.R.V.I.S. sohbeti için düşük gecikme: eleven_flash_v2_5 (varsayılan)
# Daha ağır ama daha ifade gücü yüksek: eleven_v3
# Klasik kalite: eleven_multilingual_v2
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_LANGUAGE_CODE=tr
# Ses karakteri. ElevenLabs'ın tipik başlangıç değerleri: 0.50 / 0.75 / 0.0
ELEVENLABS_STABILITY=0.50
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.0
ELEVENLABS_SPEAKER_BOOST=true
# Konuşma hızı: 1.0 normal. ElevenLabs aralığı 0.7–1.2
ELEVENLABS_SPEED=1.0
ELEVENLABS_TIMEOUT=30
ELEVENLABS_MAX_RETRIES=2
# true ise 'jarvis' her yanıtı seslendirir (--sesli bayrağı da aynı işi yapar)
JARVIS_VOICE_ENABLED=true

# --- Mikrofon (yerel STT · faster-whisper) ---
# Ses kaydı bu makinede çözümlenir, hiçbir buluta gitmez.
# Kurulum:  pip install faster-whisper
JARVIS_STT_ENABLED=true
JARVIS_VISION_ENABLED=false
JARVIS_OBJECT_VISION_ENABLED=false
JARVIS_OCR_ENABLED=false
JARVIS_FACE_RECOGNITION_ENABLED=false
# Masaüstü yakalama açık rıza gerektirir; görüntü diske kaydedilmez.
JARVIS_SCREENSHOT_ENABLED=false
# HIGH/CRITICAL bir işlem kullanıcı onayı beklediğinde yerel uyarı sesi çal.
JARVIS_APPROVAL_SOUND_ENABLED=true

# --- Multi-agent uzman rolleri (aynı model, tek seviye delegasyon) ---
JARVIS_MULTI_AGENT_ENABLED=false
JARVIS_MULTI_AGENT_MAX_DELEGATIONS=1
# tiny · base · small · medium · large-v3
# 12 GB kartta 14B model ~9 GB tutar; "small" (~0.5 GB) yanına sığar.
# "medium" Türkçede belirgin şekilde daha iyi ama ~1.5 GB ister.
JARVIS_STT_MODEL=small
# auto = GPU varsa cuda, yoksa cpu. cuDNN sorun çıkarırsa: cpu
JARVIS_STT_DEVICE=auto
JARVIS_STT_COMPUTE=auto
JARVIS_STT_LANGUAGE=tr
JARVIS_STT_HOTWORDS=Jarvis,J.A.R.V.I.S.,Oğuz,NVIDIA,Zotac,Ollama,Qwen,BIOS,UEFI,VRAM,SSD,NVMe
JARVIS_STT_INITIAL_PROMPT=Türkçe teknik servis konuşması. Asistanın adı Jarvis. Söylenen özel adları, model numaralarını, harfleri ve sayıları değiştirmeden yaz.

# --- Panel erişim jetonu ---
# Panel ağa açıldığında (--host 0.0.0.0) jeton zorunludur: bu adres makinede
# terminal komutu çalıştırabiliyor. Boş bırakılırsa HER AÇILIŞTA yeni bir jeton
# üretilir ve adres değişir — asıl can sıkan şey budur.
# Buraya sabit bir değer yazarsanız adres hiç değişmez; tarayıcı ilk ziyarette
# çerezi saklar ve bir daha jeton sayfasını görmezsiniz.
# Üretmek için:  python -c "import secrets; print(secrets.token_urlsafe(12))"
JARVIS_PANEL_TOKEN=

# --- Behaviour ---
# true  = auto-deny HIGH/CRITICAL tools (headless/automated runs)
# false = interactive approval in the terminal (default)
JARVIS_NON_INTERACTIVE=false
JARVIS_MAX_AGENT_STEPS=6
# Qwen 2.5 14B + 8192 context için mesaj bütçesi. Tool şemaları ve
# yanıt için de alan bırakmak amacıyla toplam mesaj metni sınırlanır.
JARVIS_CONTEXT_MAX_CHARS=18000
JARVIS_HISTORY_MAX_MESSAGES=24
JARVIS_TOOL_RESULT_MAX_CHARS=12000

# Where memory / audit log live
JARVIS_DATA_DIR=~/.jarvis

# --- Bilgi tabanı (RAG) ---
# Virgülle ayrılmış, açıkça izin verilen dosya/klasörler. Boşsa otomatik
# tarama yapılmaz. Değişen ve silinen belgeler panel açıkken eşitlenir.
JARVIS_RAG_AUTO_PATHS=
JARVIS_RAG_SYNC_INTERVAL=60
JARVIS_REMINDER_INTERVAL=30
JARVIS_RAG_EMBED_MODEL=bge-m3
JARVIS_RAG_EMBED_ENABLED=true

# --- Seslendirme ---
# xtts       : ANA yerel Craig dengeli sesi
# elevenlabs : bulut yedeği; .env'de sağlayıcıyı değiştirerek geri dönülür
# piper      : isteğe bağlı yerel yedek
# edge       : isteğe bağlı çevrimiçi ücretsiz yedek
# yok        : sesi tamamen kapatır
JARVIS_TTS_PROVIDER=xtts
JARVIS_PIPER_VOICE=tr_TR-dfki-medium
# JARVIS_PIPER_CUDA=false

# Request logs hide raw user text by default; enable only for deliberate local debugging.
JARVIS_TRACE_USER_TEXT=false
# Audit ve istek logları bu boyuta gelince .1, .2 ... olarak döndürülür.
JARVIS_LOG_MAX_BYTES=10485760
JARVIS_LOG_BACKUP_COUNT=5
