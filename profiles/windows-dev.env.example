# Windows/WSL kabul testi profili — üretim hafızasından ayrıdır, sır içermez.
JARVIS_PROFILE=windows-dev
JARVIS_DATA_DIR=~/.jarvis-dev
JARVIS_LLM_PROVIDER=ollama
JARVIS_OLLAMA_HOST=http://localhost:11434
JARVIS_OLLAMA_MODEL=qwen2.5:7b-instruct
JARVIS_VOICE_ENABLED=false
JARVIS_TTS_PROVIDER=yok
JARVIS_STT_ENABLED=false
JARVIS_VISION_ENABLED=false
JARVIS_WEB_ENABLED=false
JARVIS_NON_INTERACTIVE=true
JARVIS_TRACE_USER_TEXT=false
