# Linux Lite geliştirme/test profili — sır içermez.
JARVIS_PROFILE=lite
JARVIS_DATA_DIR=.jarvis-lite-data
JARVIS_LLM_PROVIDER=ollama
JARVIS_OLLAMA_MODEL=qwen3.5:2b-q4_K_M
JARVIS_OLLAMA_NUM_CTX=4096
JARVIS_OLLAMA_THINK=false
JARVIS_OLLAMA_NUM_PREDICT=256
JARVIS_OLLAMA_KEEP_ALIVE=30m
JARVIS_VOICE_ENABLED=true
JARVIS_TTS_PROVIDER=piper
JARVIS_STT_ENABLED=true
JARVIS_STT_MODEL=tiny
JARVIS_STT_DEVICE=cpu
JARVIS_STT_COMPUTE=int8
JARVIS_STT_HOTWORDS=Jarvis,J.A.R.V.I.S.,Oğuz,NVIDIA,Zotac,Ollama,Qwen,BIOS,UEFI,VRAM,SSD,NVMe
JARVIS_STT_INITIAL_PROMPT=Türkçe teknik servis konuşması. Asistanın adı Jarvis. Söylenen özel adları, model numaralarını, harfleri ve sayıları değiştirmeden yaz.
JARVIS_VISION_ENABLED=true
JARVIS_WEB_ENABLED=false
JARVIS_NON_INTERACTIVE=true
JARVIS_TRACE_USER_TEXT=false
